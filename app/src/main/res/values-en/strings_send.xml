    <!-- ============ Community Standards — Section B title ============ -->
    <string name="send_community_section_title">Community Standards</string>
    <string name="send_community_intro_bold">Community Standards are established to ensure a civilised, safe and positive environment for all members participating in the Sun* Kudos recognition and appreciation programme.</string>
    <string name="send_community_criteria_intro">Content found to meet one of the violation criteria below will be labelled as Spam and proactively hidden by the system.</string>

    <!-- Community criteria — 10 items (indices 1–10) -->
    <string name="send_community_criterion_1">Use of profanity, vulgar language, or content that is offensive or defamatory.</string>
    <string name="send_community_criterion_2">References to political, religious, or gender-discriminatory topics.</string>
    <string name="send_community_criterion_3">Contains specific figures (revenue, contracts, KPIs, clients, project codes, account numbers, etc.).</string>
    <string name="send_community_criterion_4">Mentions partner names, clients, or external organisations.</string>
    <string name="send_community_criterion_5">Contains personal information (email, phone number, address, family details).</string>
    <string name="send_community_criterion_6">Sending 3+ messages with similar content repeatedly in a short period.</string>
    <string name="send_community_criterion_7">Kudos content is too short (under 30 characters) with no context (\"Thanks a lot\", \"Thanks!\", \"Good job!\").</string>
    <string name="send_community_criterion_8">Sending to too many people/groups in a short period (&lt;3s/message).</string>
    <string name="send_community_criterion_9">Spam language (containing only characters such as \".\", \",\", \"...\", or meaningless characters).</string>
    <string name="send_community_criterion_10">Abnormal spike in \"hearts\" (based on average user behaviour).</string>

    <!-- ============ Community Standards — Section C (Security) ============ -->
    <string name="send_security_section_title">Security Standards</string>
    <string name="send_security_intro">Sunners are committed to protecting information. Every member is responsible for keeping shared content secure on the system.</string>
    <string name="send_security_item_a_label">Information Security</string>
    <string name="send_security_item_a_body">All information Sunners share will be kept secure on the system.</string>
    <string name="send_security_item_b_label">Scope of Sharing</string>
    <string name="send_security_item_b_body">All personnel and project information in the system is confidential. Sunners are requested to share only within Sun* internally.</string>
    <string name="send_security_contact_label">Contact Support: </string>
    <string name="send_security_contact_body">For any questions, Sunners please contact the SAA Organising Committee representative: Slack duong.thi.thuy.an for assistance.</string>
